{
  "compilerOptions": {
    "outDir": "./dist/",
    "sourceMap": true,
    "strictNullChecks": true,
    "module": "esnext",
    "jsx": "react-jsx",
    "target": "ESNext",
    "allowJs": true,
    // Lets `src/` modules be imported by bare name, as in `from 'routes'`.
    // TypeScript 7 removed `baseUrl`; `vite-tsconfig-paths` mirrors this into Vite.
    "paths": { "*": ["./src/*"] },
    "lib": ["dom", "dom.iterable", "esnext"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["vite/client"]
  },
  "include": ["./src/"],
  "exclude": ["node_modules"]
}
